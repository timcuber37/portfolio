# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx

# editor / tooling
.vscode/
.idea/
# Personal Claude Code skills (resume tailoring) — they read from the ignored
# knowledge-base/, so committing them alone would leave dangling references.
# Force-add with `git add -f` if a skill is ever worth sharing.
.claude/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# NOTE: the generated Prisma client (src/generated/prisma) is intentionally
# committed. The `prisma-client` generator emits portable TypeScript with no
# native binaries, so committing it guarantees it's present on Vercel even if
# the build's `prisma generate` step is skipped. Regenerate + recommit after
# changing prisma/schema.prisma.

# local database (rebuild with: npx tsx prisma/seed.ts)
*.db
*.db-journal
*.db-wal
*.db-shm

# Snapshot of live site content written by scripts/export-content.ts. It is a
# full dump of production copy, meant to be folded into prisma/seed.ts by hand
# and then discarded — not committed on its own.
db-export.json

# personal job-application files (kept out of the repo / deploy)
description.md
cover-letter*.md
public/resume.md
# Case matters on Linux/CI checkouts; must match the file exactly.
RESUME_CONTRIBUTIONS.md
/resumes
/cover-letters
/planning
/knowledge-base
