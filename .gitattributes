# Normalize all text files to LF in the repository; Git handles the
# working-copy line endings per platform automatically.
* text=auto eol=lf

# Binary assets — never apply line-ending conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.db binary
*.mp4 binary
*.webm binary
*.mov binary
*.m4v binary
