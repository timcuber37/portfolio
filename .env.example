# Copy to .env.local and fill in. Never commit your real .env.local.

# Database (libSQL adapter).
# Local dev: a SQLite file relative to the project root.
# Production (e.g. Vercel): a hosted libSQL/Turso URL, e.g. libsql://<db>-<org>.turso.io
DATABASE_URL="file:./dev.db"

# Required only for hosted libSQL/Turso (leave blank for a local file DB).
DATABASE_AUTH_TOKEN=""

# Admin panel login password (checked by /api/admin/login).
ADMIN_PASSWORD="change-me"

# Opaque token stored in the admin_session cookie after a successful login.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_TOKEN="generate-a-random-hex-string"

# Optional — enables "Import from GitHub" and "Refine with AI" in the admin panel (Claude API).
ANTHROPIC_API_KEY=""

# Optional — raises GitHub's API rate limit (60 -> 5000/hr) and allows private repos for the importer.
GITHUB_TOKEN=""
